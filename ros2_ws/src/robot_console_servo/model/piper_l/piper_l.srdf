<robot name="piper_l">
  <group name="arm">
    <chain base_link="base_link" tip_link="link6" />
  </group>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="world" reason="Adjacent" />
  <disable_collisions link1="finger_envelope1" link2="finger_envelope2" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="finger_envelope1" link2="flange_link" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="finger_envelope1" link2="gripper_base" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="finger_envelope1" link2="link6" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="finger_envelope2" link2="flange_link" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="finger_envelope2" link2="gripper_base" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="finger_envelope2" link2="link6" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="flange_link" link2="gripper_base" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="flange_link" link2="link5" reason="Adjacent" />
  <disable_collisions link1="flange_link" link2="link6" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="gripper_base" link2="link5" reason="Adjacent" />
  <disable_collisions link1="gripper_base" link2="link6" reason="Rigid gripper assembly / swept envelope overlap" />
  <disable_collisions link1="link1" link2="link2" reason="Adjacent" />
  <disable_collisions link1="link2" link2="link3" reason="Adjacent" />
  <disable_collisions link1="link3" link2="link4" reason="Adjacent" />
  <disable_collisions link1="link4" link2="link5" reason="Adjacent" />
  <disable_collisions link1="link5" link2="link6" reason="Adjacent" />
</robot>