<Window x:Class="RustRemoval.RobotConsole.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RustRemoval.RobotConsole.Controls"
        xmlns:vm="clr-namespace:RustRemoval.RobotConsole.ViewModels"
        Title="铁塔除锈车 · 地面调试 v8.1 PIPER-L CPV" Width="1500" Height="940" MinWidth="1180" MinHeight="760"
        WindowState="Maximized" Background="{StaticResource PageBrush}" KeyDown="Window_KeyDown"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#243948"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="44"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#50687A" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,4,4,10"/>
        </Style>
        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#263747"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSatisfied}" Value="True"><Setter Property="Fill" Value="{StaticResource GoodBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top status bar: every condition is represented by both text and color. -->
        <Border Grid.Row="0" Background="#101A24" BorderBrush="#314252" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.55*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="铁塔除锈车" FontSize="24" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal"><Button Content="连接设置" Click="ConnectionSettings_Click" Padding="6,3" MinHeight="36"/><Button Content="详细诊断" Click="Diagnostics_Click" Padding="6,3" MinHeight="36"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="当前模式" Foreground="{StaticResource MutedBrush}"/>
                    <Border Background="#1A7181" CornerRadius="4" Padding="9,4" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ModeText}" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding LinkStateText}" FontSize="12" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsLinkConnected}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="电量" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding BatteryDisplay}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="UDP RTT / ACK 超时率" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding NetworkText}" FontSize="16" TextWrapping="Wrap" ToolTip="实际控制包往返时间；1 秒未确认的回执比例，最近 5 秒已结算样本"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="车身姿态" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock FontSize="15" Text="{Binding BaseAttitudeDisplay}"/>
                </StackPanel>
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock Text="最小关节裕量" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding MinimumJointText}" FontSize="20" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsMinimumJointWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
            <Border Background="#B71C1C" Padding="12,8" Visibility="{Binding IsEmergencyStopped, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="⛔ 急停已触发 · 所有控制已锁定 · 确认现场安全后显式复位" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
            <Border Background="#B71C1C" Padding="12,8" Visibility="{Binding IsControlLost, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="⚠ 控制链路已断开 · 禁止发送常规指令 · 机器人停止状态需现场确认" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="500"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Left control rail -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="8">
                    <UniformGrid Columns="3">
                        <Button Content="待机" Command="{Binding SwitchToStandbyCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButton}"><Style.Triggers><DataTrigger Binding="{Binding IsStandbyMode}" Value="True"><Setter Property="Background" Value="#16889A"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="行驶模式" Command="{Binding SwitchToDriveCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDriveMode}" Value="True"><Setter Property="Background" Value="#16889A"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="作业模式" Command="{Binding SwitchToWorkCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeButton}"><Style.Triggers><DataTrigger Binding="{Binding IsWorkMode}" Value="True"><Setter Property="Background" Value="#16889A"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </UniformGrid>
                </Border>

                <Grid Grid.Row="1">
                    <Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="请选择行驶模式或作业模式" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="待机状态下不会发送运动指令" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8"/>
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsStandbyMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel IsEnabled="{Binding IsDrivePanelEnabled}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDriveMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="驱动子模式" Style="{StaticResource SectionTitle}"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton Content="标准转向" IsChecked="{Binding IsStandardDrive, Mode=OneWay}" Command="{Binding SetStandardDriveCommand}"/>
                                        <RadioButton Content="蟹行平移" IsChecked="{Binding IsCrabDrive, Mode=OneWay}" Command="{Binding SetCrabDriveCommand}"/>
                                        <RadioButton Content="原地旋转" IsChecked="{Binding IsSpinDrive, Mode=OneWay}" Command="{Binding SetSpinDriveCommand}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="全向平移" Style="{StaticResource SectionTitle}"/>
                                        <controls:VirtualJoystick x:Name="DriveJoystick" Width="205" Height="205" ValueChanged="DriveJoystick_ValueChanged"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="四轮舵向" Style="{StaticResource SectionTitle}"/>
                                        <Viewbox Height="205">
                                            <Grid Width="180" Height="240">
                                                <Border Margin="42,18" Background="#263B4C" BorderBrush="#6F8798" BorderThickness="3" CornerRadius="22"/>
                                                <TextBlock Text="车头 ↑" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="15"/>
                                                <Rectangle Width="22" Height="58" RadiusX="5" Fill="#20B8CD" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,38,0,0"><Rectangle.RenderTransform><RotateTransform Angle="{Binding FrontLeftAngle}"/></Rectangle.RenderTransform></Rectangle>
                                                <Rectangle Width="22" Height="58" RadiusX="5" Fill="#20B8CD" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,38,20,0"><Rectangle.RenderTransform><RotateTransform Angle="{Binding FrontRightAngle}"/></Rectangle.RenderTransform></Rectangle>
                                                <Rectangle Width="22" Height="58" RadiusX="5" Fill="#20B8CD" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,30"><Rectangle.RenderTransform><RotateTransform Angle="{Binding RearLeftAngle}"/></Rectangle.RenderTransform></Rectangle>
                                                <Rectangle Width="22" Height="58" RadiusX="5" Fill="#20B8CD" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,30"><Rectangle.RenderTransform><RotateTransform Angle="{Binding RearRightAngle}"/></Rectangle.RenderTransform></Rectangle>
                                            </Grid>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DriveReadout}" HorizontalAlignment="Center" FontSize="17"/>
                                    <DockPanel Margin="3,10,3,0"><TextBlock Text="原地自转" Width="88" VerticalAlignment="Center"/><Slider Minimum="-100" Maximum="100" Value="{Binding Rotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding RotationText}" Width="48" VerticalAlignment="Center"/></DockPanel>
                                    <Button Content="{Binding SpeedGearText}" Command="{Binding ToggleSpeedCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWorkMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel><TextBlock Text="末端左右／上下" Style="{StaticResource SectionTitle}"/><controls:VirtualJoystick x:Name="ArmJoystick" IsEnabled="{Binding CanJogArm}" Width="175" Height="175" ValueChanged="ArmJoystick_ValueChanged"/><TextBlock Text="{Binding ArmReadout}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="平移点动速度" FontWeight="Bold" Margin="0,12,0,0"/>
                                        <Slider x:Name="JogSpeedSlider" Minimum="2" Maximum="{Binding JogSpeedMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" MinHeight="44" Value="{Binding JogSpeedMmS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="平移目标速度，2 至 50 毫米每秒"/>
                                        <TextBlock Text="{Binding JogSpeedText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="姿态点动速度" FontWeight="Bold" Margin="0,10,0,0"/>
                                        <Slider x:Name="JogAngularSpeedSlider" Minimum="1" Maximum="{Binding JogAngularMaximum}" TickFrequency="1" IsSnapToTickEnabled="True" MinHeight="44" Value="{Binding JogAngularSpeedDegS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="姿态目标速度，1 至 10 度每秒"/>
                                        <TextBlock Text="{Binding JogAngularSpeedText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="调速后重新按住；不改变回零速度。实机仅开放 2 mm/s、1°/s；更高档位未验证。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="末端位姿与诊断" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ArmDiagnostics}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="伸出／收回（X 轴）" Foreground="{StaticResource MutedBrush}"/>
                                        <UniformGrid Columns="3"><Button Content="收回" Tag="x-" MinWidth="50" Padding="6,8" IsEnabled="{Binding CanJogArm}" PreviewMouseLeftButtonDown="Axis_MouseDown" PreviewMouseLeftButtonUp="Axis_MouseUp" LostMouseCapture="Axis_LostMouseCapture" PreviewTouchDown="Axis_TouchDown" PreviewTouchUp="Axis_TouchUp" LostTouchCapture="Axis_LostTouchCapture"/><TextBlock Visibility="{Binding HasArmPose, Converter={StaticResource BoolVisibility}}" Text="X" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Content="伸出" Tag="x+" MinWidth="50" Padding="6,8" IsEnabled="{Binding CanJogArm}" PreviewMouseLeftButtonDown="Axis_MouseDown" PreviewMouseLeftButtonUp="Axis_MouseUp" LostMouseCapture="Axis_LostMouseCapture" PreviewTouchDown="Axis_TouchDown" PreviewTouchUp="Axis_TouchUp" LostTouchCapture="Axis_LostTouchCapture"/></UniformGrid>
                                        <TextBlock Text="俯仰 (°)" Foreground="{StaticResource MutedBrush}"/>
                                        <UniformGrid Columns="3"><Button Content="－" Tag="pitch-" MinWidth="50" Padding="6,8" IsEnabled="{Binding CanJogArm}" PreviewMouseLeftButtonDown="Axis_MouseDown" PreviewMouseLeftButtonUp="Axis_MouseUp" LostMouseCapture="Axis_LostMouseCapture" PreviewTouchDown="Axis_TouchDown" PreviewTouchUp="Axis_TouchUp" LostTouchCapture="Axis_LostTouchCapture"/><TextBlock Visibility="{Binding HasArmPose, Converter={StaticResource BoolVisibility}}" Text="{Binding ArmPitch, StringFormat={}{0:F0}}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Content="＋" Tag="pitch+" MinWidth="50" Padding="6,8" IsEnabled="{Binding CanJogArm}" PreviewMouseLeftButtonDown="Axis_MouseDown" PreviewMouseLeftButtonUp="Axis_MouseUp" LostMouseCapture="Axis_LostMouseCapture" PreviewTouchDown="Axis_TouchDown" PreviewTouchUp="Axis_TouchUp" LostTouchCapture="Axis_LostTouchCapture"/></UniformGrid>
                                        <TextBlock Text="偏航 (°)" Foreground="{StaticResource MutedBrush}"/>
                                        <UniformGrid Columns="3"><Button Content="－" Tag="yaw-" MinWidth="50" Padding="6,8" IsEnabled="{Binding CanJogArm}" PreviewMouseLeftButtonDown="Axis_MouseDown" PreviewMouseLeftButtonUp="Axis_MouseUp" LostMouseCapture="Axis_LostMouseCapture" PreviewTouchDown="Axis_TouchDown" PreviewTouchUp="Axis_TouchUp" LostTouchCapture="Axis_LostTouchCapture"/><TextBlock Visibility="{Binding HasArmPose, Converter={StaticResource BoolVisibility}}" Text="{Binding ArmYaw, StringFormat={}{0:F0}}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Content="＋" Tag="yaw+" MinWidth="50" Padding="6,8" IsEnabled="{Binding CanJogArm}" PreviewMouseLeftButtonDown="Axis_MouseDown" PreviewMouseLeftButtonUp="Axis_MouseUp" LostMouseCapture="Axis_LostMouseCapture" PreviewTouchDown="Axis_TouchDown" PreviewTouchUp="Axis_TouchUp" LostTouchCapture="Axis_LostTouchCapture"/></UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="关节限位裕量" Style="{StaticResource SectionTitle}"/></DockPanel>
                                    <ItemsControl ItemsSource="{Binding JointMargins}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:JointMarginViewModel}">
                                                <StackPanel Margin="4"><TextBlock Text="{Binding Value, StringFormat={}{0:F0}%}" HorizontalAlignment="Center"/><ProgressBar Value="{Binding Value}" Maximum="100" Height="54" Width="28" Orientation="Vertical"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/></StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="激光除锈参数" Style="{StaticResource SectionTitle}"/>
                                    <UniformGrid Columns="3"><Button Content="轻度锈" Command="{Binding LightPresetCommand}"/><Button Content="中度锈" Command="{Binding MediumPresetCommand}"/><Button Content="重度锈" Command="{Binding HeavyPresetCommand}"/></UniformGrid>
                                    <DockPanel><TextBlock Text="功率" Width="55" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding LaserPower, Mode=TwoWay}"/><TextBlock Text="{Binding LaserPower, StringFormat={}{0:F0}%}" Width="50" VerticalAlignment="Center"/></DockPanel>
                                    <DockPanel><TextBlock Text="速度" Width="55" VerticalAlignment="Center"/><Slider Minimum="1" Maximum="8" TickFrequency="0.1" Value="{Binding ScanSpeed, Mode=TwoWay}"/><TextBlock Text="{Binding ScanSpeed, StringFormat={}{0:F1}}" Width="50" VerticalAlignment="Center"/></DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Background="#20171A"><StackPanel>
                    <UniformGrid Columns="3"><Button Content="使能 / CAN 控制" Command="{Binding EnableArmCommand}"/><Button Content="恢复急停" Command="{Binding RecoverArmCommand}"/><Button Content="设为零位" Command="{Binding SetHomeCommand}"/></UniformGrid>
                    <UniformGrid Columns="2"><Button Content="回到记录零位" Command="{Binding ReturnHomeCommand}"/><Button Content="停止回零" Command="{Binding StopHomeCommand}"/></UniformGrid>
                    <TextBlock Text="{Binding PathText}" Foreground="{StaticResource GoodBrush}"/><TextBlock Text="{Binding HomeStatus}" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding ActionNotice}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ArmBlockHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding ArmBlockHint}"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><Button Command="{Binding ToggleLaserCommand}" Background="#177F91"><TextBlock Text="{Binding LaserButtonText}" Foreground="White" FontWeight="SemiBold"/></Button><TextBlock Text="{Binding LaserActionHint}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="8,1"/></StackPanel>
                        <Button Grid.Column="1" Content="紧急停止" Command="{Binding AlwaysEstopCommand}" FontSize="20" FontWeight="Bold" Background="#C62828">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#C62828"/><Style.Triggers><DataTrigger Binding="{Binding IsEmergencyStopped}" Value="True"><Setter Property="Background" Value="#9A6818"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
                </Border>
            </Grid>

            <!-- Right: video, detections and interlocks -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid Background="#05090D">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="1000" Height="562.5">
                                <Image Source="{Binding VideoFrame}" Stretch="Fill"/><controls:WebRtcView x:Name="WebRtcVideo" Active="{Binding UsesWebRtc}" StreamUrl="{Binding WebRtcUrl}" Visibility="{Binding UsesWebRtc, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False"/>
                                <ItemsControl ItemsSource="{Binding RustSpots}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="1000" Height="562.5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RustSpotViewModel}">
                                            <Button Command="{Binding DataContext.SelectSpotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Width="{Binding Width}" Height="{Binding Height}">
                                                <Grid><Border BorderBrush="#FFD22E" BorderThickness="4" Background="#15FFD22E"><Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FFD22E"/><Setter Property="BorderThickness" Value="4"/><Setter Property="Background" Value="#15FFD22E"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#35F0FF"/><Setter Property="BorderThickness" Value="7"/><Setter Property="Background" Value="#3035F0FF"/></DataTrigger></Style.Triggers></Style></Border.Style></Border><Border Background="#D9A06A00" VerticalAlignment="Top" HorizontalAlignment="Left" Padding="8,4"><TextBlock Text="{Binding ConfidenceText}" FontSize="18" FontWeight="Bold"/></Border></Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="#E50B1118" Visibility="{Binding IsVideoLost, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="510"><TextBlock Text="图像丢失" FontSize="42" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/><TextBlock Text="激光联锁已断开。请选择立即停止或原地等待视频恢复。" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" Margin="0,12,0,20"/><UniformGrid Columns="2"><Button Content="盲操作停止" Command="{Binding AlwaysEstopCommand}" Background="#C62828"/><Button Content="等待恢复" Command="{Binding WaitForVideoCommand}"/></UniformGrid></StackPanel>
                                </Border>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel><TextBlock DockPanel.Dock="Top" Text="锈斑列表" Style="{StaticResource SectionTitle}"/><ListBox ItemsSource="{Binding RustSpots}" SelectedItem="{Binding SelectedSpot, Mode=OneWay}" Background="Transparent" BorderThickness="0" Foreground="White"><ListBox.ItemTemplate><DataTemplate><Button Content="{Binding ConfidenceText}" Command="{Binding DataContext.SelectSpotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" MinHeight="46" Width="230"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#16889A"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel><TextBlock DockPanel.Dock="Top" Text="激光硬件未接入" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding VisibleInterlocks}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="31"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Ellipse Grid.Column="0" Style="{StaticResource StatusDot}"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSatisfied}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel><TextBlock Text="{Binding SensorText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4"/><TextBlock Text="影像操作" Style="{StaticResource SectionTitle}"/><Button Content="拍照" Command="{Binding SnapshotCommand}"/><Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Background" Value="#B71C1C"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="协议 v1 未定义媒体控制" Foreground="{StaticResource WarningBrush}" TextAlignment="Center" TextWrapping="Wrap" Visibility="{Binding HasProtocolV1Limitations, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding FeedbackText}" Foreground="{StaticResource GoodBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="4"/></StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- A control loss blocks the complete surface. Only reconnect and emergency stop remain. -->
        <Border Grid.Row="2" Background="#E60B1118" Visibility="{Binding IsControlLost, Converter={StaticResource BoolVisibility}}" Panel.ZIndex="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="650">
                <TextBlock Text="控制链路已断开" FontSize="44" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="已停止常规控制输入；机器人设有独立软件看门狗。停止效果需现场确认，恢复通信不会自动续动。" FontSize="19" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,24"/>
                <UniformGrid Columns="2"><Button Content="尝试重连" Command="{Binding ReconnectCommand}" Background="#177F91"/><Button Content="紧急停止" Command="{Binding AlwaysEstopCommand}" Background="#C62828"/></UniformGrid>
            </StackPanel>
        </Border>

        <Border x:Name="DebugPanel" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top" Width="390" Margin="12" Padding="16" Background="#F51D2834" BorderBrush="#8AA1B3" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" Panel.ZIndex="40">
            <StackPanel>
                <DockPanel><TextBlock Text="演示调试面板" FontSize="20" FontWeight="Bold"/><TextBlock Text="Ctrl+Shift+D 关闭" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel>
                <TextBlock Text="链路状态" Style="{StaticResource SectionTitle}" Margin="0,14,0,5"/>
                <UniformGrid Columns="2"><Button Content="Connected" Command="{Binding DebugSetConnectedCommand}"/><Button Content="VideoLost" Command="{Binding DebugSetVideoLostCommand}"/><Button Content="ControlLost" Command="{Binding DebugSetControlLostCommand}"/><Button Content="Reconnecting" Command="{Binding DebugSetReconnectingCommand}"/></UniformGrid>
                <TextBlock Text="翻转联锁项" Style="{StaticResource SectionTitle}" Margin="0,14,0,5"/>
                <ComboBox SelectedIndex="{Binding DebugInterlockIndex}" MinHeight="44" FontSize="15"><ComboBoxItem Content="车辆稳定停止"/><ComboBoxItem Content="机械臂姿态安全域"/><ComboBoxItem Content="末端距离合规"/><ComboBoxItem Content="防护挡板到位"/><ComboBoxItem Content="作业区域无人员"/></ComboBox>
                <Button Content="满足 ↔ 不满足" Command="{Binding DebugToggleInterlockCommand}" Margin="4,10"/>
                <TextBlock Text="此面板仅存在于 Mock 演示，不进入真实通信接口。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>



