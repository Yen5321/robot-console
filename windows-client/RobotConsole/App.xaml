<Application x:Class="RustRemoval.RobotConsole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0B1118"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#141D27"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#1B2734"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#34475A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F7FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A9BBC9"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#20B8CD"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#36C98F"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F4B942"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F05252"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#263747"/>
            <Setter Property="BorderBrush" Value="#4C6579"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#345268"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#177F91"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="#263747"/>
        </Style>
    </Application.Resources>
</Application>
